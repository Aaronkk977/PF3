generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id             String        @id @default(cuid())
  name           String
  currency       String        @default("TWD")
  cash           Decimal       @default(0)
  feeRateBps     Float         @default(4)
  taxRatePct     Float         @default(0.003)
  feeRateBpsBuy  Float?
  feeRateBpsSell Float?
  taxRatePctBuy  Float?
  taxRatePctSell Float?
  /** 手續費與稅：無條件捨去，低消 1 元 */
  feeTaxRoundHalfUp Boolean     @default(false)
  transactions   Transaction[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt @default(now())
}

model Instrument {
  id           String            @id @default(cuid())
  symbol       String            @unique
  name         String?
  /** 使用者 Markdown 投資筆記 */
  notes        String?
  assetClass   String            @default("stock")
  currency     String?
  feeRateBps   Int?
  taxRatePct   Float?
  transactions Transaction[]
  tags         TagOnInstrument[]
  noteLinks    NoteOnInstrument[]
  splits       Split[]
  /** 上次檢查股票分割的時間，避免每次載入都打 Yahoo（24 小時冷卻） */
  splitsCheckedAt DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt @default(now())
}

/** 股票分割稽核記錄：偵測到分割時，該支股票分割日之前的所有交易會被改寫
 *  （quantity ×= numerator/denominator，price ×= denominator/numerator），
 *  這裡記錄「哪支股票、哪天分割過」避免重複套用。 */
model Split {
  id           String     @id @default(cuid())
  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  splitDate    DateTime
  numerator    Int
  denominator  Int
  appliedAt    DateTime   @default(now())

  @@unique([instrumentId, splitDate])
  @@index([instrumentId])
}

model Watchlist {
  id        String          @id @default(cuid())
  name      String          @unique
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  items     WatchlistItem[]
}

model WatchlistItem {
  id          String    @id @default(cuid())
  watchlistId String
  /** 分隔線／小標項目 symbol 為 null（SQLite 唯一索引允許多筆 null） */
  symbol      String?
  name        String?
  /** SYMBOL（預設）｜ SEPARATOR（分隔線／小標，label 顯示文字） */
  kind        String    @default("SYMBOL")
  label       String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, symbol])
  @@index([watchlistId])
}

model Tag {
  id          String            @id @default(cuid())
  name        String            @unique
  instruments TagOnInstrument[]
  noteLinks   NoteOnTag[]
}

model TagOnInstrument {
  instrumentId String
  tagId        String
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  tag          Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([instrumentId, tagId])
}

/** 筆記類型：使用者可自行新增／刪除，含三個系統預設值（種子資料）。
  * Note.kind 只存名稱字串（不是外鍵），刪除一個類型不會動到已使用該類型的
  * 舊筆記，只是它從此不再出現在新增筆記的下拉選單裡。 */
model NoteKind {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Note {
  id       String   @id @default(cuid())
  title    String
  /** Markdown 內容 */
  content  String
  /** 筆記類型名稱（對應 NoteKind.name，非外鍵） */
  kind     String
  /** 筆記日期，預設今天，使用者可編輯，用於排序與複盤 */
  noteDate DateTime @default(now())

  instruments NoteOnInstrument[]
  tags        NoteOnTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  @@index([kind])
  @@index([noteDate])
}

model NoteOnInstrument {
  noteId       String
  instrumentId String
  note         Note       @relation(fields: [noteId], references: [id], onDelete: Cascade)
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@id([noteId, instrumentId])
  @@index([instrumentId])
}

model NoteOnTag {
  noteId String
  tagId  String
  note   Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@index([tagId])
}

model Transaction {
  id           String      @id @default(cuid())
  accountId    String
  instrumentId String?
  type         String
  date         DateTime
  quantity     Decimal
  price        Decimal
  fee          Decimal     @default(0)
  tax          Decimal     @default(0)
  note         String?
  account      Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  instrument   Instrument? @relation(fields: [instrumentId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt @default(now())

  @@index([accountId])
  @@index([instrumentId])
  @@index([date])
}

model FxRateCache {
  id       String   @id @default(cuid())
  pair     String   @unique
  rate     Float
  cachedAt DateTime @default(now())
}

/** 特定日期的歷史匯率快取，過去的收盤匯率不會變，永久快取（不像
 *  FxRateCache 的即期匯率需要 TTL），避免每次算成本基礎都重打 Yahoo。 */
model FxRateHistory {
  id      String @id @default(cuid())
  pair    String
  dateKey String
  rate    Float

  @@unique([pair, dateKey])
  @@index([pair])
}

model PerformanceSnapshot {
  id              String   @id @default(cuid())
  cacheKey        String   @unique
  periodStart     String
  periodEnd       String
  benchmarkSymbol String
  dataFingerprint String
  payload         String
  computedAt      DateTime @default(now())
}

model PortfolioValueSnapshot {
  id          String   @id @default(cuid())
  cacheKey    String   @unique
  periodStart String
  periodEnd   String
  txCount     Int
  maxTxDate   String
  payload     String
  computedAt  DateTime @default(now())
}

model Benchmark {
  id     String @id @default(cuid())
  symbol String @unique
  label  String
}

/// 單一列（id 固定為 1）：記錄「開機維護」（股票分割偵測＋幣別／追蹤清單
/// 名稱校正）上次跑完的時間，跟頁面資料查詢完全脫鉤，靠這個時間戳記做
/// 24 小時冷卻，而不是每個頁面各自觸發一次。
model AppMaintenance {
  id        Int      @id @default(1)
  lastRunAt DateTime?
}

/// 使用者設定（主題、配色、各頁篩選與排序…），key 見 src/lib/setting-keys.ts，
/// value 為 JSON 字串。以前只存在瀏覽器 localStorage，換埠號就讀不到。
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @default(now())
}

model PriceCache {
  id        String   @id @default(cuid())
  symbol    String
  date      DateTime
  open      Float?
  high      Float?
  low       Float?
  close     Float
  volume    Float?
  cachedAt  DateTime @default(now())

  @@unique([symbol, date])
  @@index([symbol])
}

/// 全市場盤後快照（來源：TWSE / TPEx 公開資料）
model MarketDailySnapshot {
  id            String   @id @default(cuid())
  symbol        String
  name          String?
  date          String   // YYYY-MM-DD
  open          Float?
  high          Float?
  low           Float?
  close         Float
  volume        Float    // 成交股數
  turnover      Float?   // 成交金額（元）
  changePercent Float?
  exchange      String   // "TWSE" | "TPEx"
  createdAt     DateTime @default(now())

  @@unique([symbol, date])
  @@index([symbol])
  @@index([date])
  @@index([exchange, date])
}
